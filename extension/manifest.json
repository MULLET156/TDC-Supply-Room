{
  "manifest_version": 3,
  "name": "Supply Room Price Helper",
  "version": "1.2.0",
  "description": "Saves the prices you see on your dental suppliers' websites (including signed-in account prices) to your Supply Room.",
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Supply Room" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.henryschein.com/*", "https://*.pattersondental.com/*", "https://*.benco.com/*", "https://*.darbydental.com/*",
    "https://*.safcodental.com/*", "https://*.net32.com/*", "https://*.frontierdental.com/*", "https://*.dentalcity.com/*",
    "https://*.ultradent.com/*", "https://*.blueskybio.com/*", "https://*.brasselerusa.com/*", "https://*.burkhartdental.com/*",
    "https://*.scottsdental.com/*", "https://*.practicon.com/*", "https://*.pearsondental.com/*", "https://*.dhpsupply.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [{
    "matches": [
      "https://*.henryschein.com/*", "https://*.pattersondental.com/*", "https://*.benco.com/*", "https://*.darbydental.com/*",
      "https://*.safcodental.com/*", "https://*.net32.com/*", "https://*.frontierdental.com/*", "https://*.dentalcity.com/*",
      "https://*.ultradent.com/*", "https://*.blueskybio.com/*", "https://*.brasselerusa.com/*", "https://*.burkhartdental.com/*",
      "https://*.scottsdental.com/*", "https://*.practicon.com/*", "https://*.pearsondental.com/*", "https://*.dhpsupply.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
